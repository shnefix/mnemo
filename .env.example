# Mnemo — AI provider configuration (used from Phase 3 on; the app runs fully without it)
# Copy to .env and fill in only the provider you use. Never commit .env.

# anthropic | openai | ollama
MNEMO_AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
