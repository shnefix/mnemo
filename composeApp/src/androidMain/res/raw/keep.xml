<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud.android.kt looks these up by name (getIdentifier), which the release build's resource
     shrinker cannot see: without this it removed default_web_client_id and sign-in disappeared. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/google_app_id,@string/google_api_key,@string/project_id,@string/gcm_defaultSenderId,@string/google_storage_bucket,@string/default_web_client_id" />
