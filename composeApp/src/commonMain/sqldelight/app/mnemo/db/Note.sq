CREATE TABLE note (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    deck_id INTEGER NOT NULL REFERENCES deck(id) ON DELETE CASCADE,
    note_type_id INTEGER NOT NULL REFERENCES note_type(id),
    fields_json TEXT NOT NULL,   -- {"Front":"...","Back":"..."}
    tags TEXT NOT NULL DEFAULT '', -- space separated, each tag wrapped: " a b "
    source_id INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    uid TEXT -- stable identity across devices (sync); filled by note_uid on insert
);

CREATE INDEX note_deck ON note(deck_id);
CREATE INDEX note_uid_idx ON note(uid);

CREATE TRIGGER note_uid AFTER INSERT ON note WHEN new.uid IS NULL
BEGIN
    UPDATE note SET uid = lower(hex(randomblob(16))) WHERE id = new.id;
END;

-- Tombstones so a sync does not bring deleted notes back.
CREATE TABLE deleted_note (
    uid TEXT NOT NULL PRIMARY KEY,
    deleted_at INTEGER NOT NULL
);

CREATE TRIGGER note_tombstone AFTER DELETE ON note WHEN old.uid IS NOT NULL
BEGIN
    INSERT OR REPLACE INTO deleted_note(uid, deleted_at) VALUES (old.uid, CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

selectById:
SELECT * FROM note WHERE id = ?;

selectByDeck:
SELECT * FROM note WHERE deck_id = ? ORDER BY created_at DESC;

selectAll:
SELECT * FROM note ORDER BY created_at DESC;

insert:
INSERT INTO note(deck_id, note_type_id, fields_json, tags, source_id, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

update:
UPDATE note SET deck_id = ?, fields_json = ?, tags = ?, updated_at = ? WHERE id = ?;

updateTags:
UPDATE note SET tags = ?, updated_at = ? WHERE id = ?;

moveToDeck:
UPDATE note SET deck_id = ?, updated_at = ? WHERE id = ?;

delete:
DELETE FROM note WHERE id = ?;

countAll:
SELECT count(*) FROM note;

countByDeck:
SELECT count(*) FROM note WHERE deck_id = ?;

allTags:
SELECT DISTINCT tags FROM note WHERE tags != '';

-- Importer keys (Markdown vault cards), for skipping what was imported before.
sourceIds:
SELECT source_id FROM note WHERE source_id IS NOT NULL;

setUid:
UPDATE note SET uid = ? WHERE id = ?;

selectByUid:
SELECT * FROM note WHERE uid = ?;

allTombstones:
SELECT * FROM deleted_note;

addTombstone:
INSERT OR REPLACE INTO deleted_note(uid, deleted_at) VALUES (?, ?);

deleteByUid:
DELETE FROM note WHERE uid = ?;

-- Seed updates: keep a note looking unedited so a later content version can update it again.
markUnedited:
UPDATE note SET updated_at = created_at WHERE id IN ?;

pruneTombstones:
DELETE FROM deleted_note WHERE deleted_at < ?;
