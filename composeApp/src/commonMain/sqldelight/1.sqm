ALTER TABLE note ADD COLUMN uid TEXT;
UPDATE note SET uid = lower(hex(randomblob(16)));
CREATE INDEX note_uid_idx ON note(uid);

CREATE TRIGGER note_uid AFTER INSERT ON note WHEN new.uid IS NULL
BEGIN
    UPDATE note SET uid = lower(hex(randomblob(16))) WHERE id = new.id;
END;

CREATE TABLE deleted_note (
    uid TEXT NOT NULL PRIMARY KEY,
    deleted_at INTEGER NOT NULL
);

CREATE TRIGGER note_tombstone AFTER DELETE ON note WHEN old.uid IS NOT NULL
BEGIN
    INSERT OR REPLACE INTO deleted_note(uid, deleted_at) VALUES (old.uid, CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
